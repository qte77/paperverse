{
  // Self-contained config so local `make lint_md` matches CI behaviour
  // independent of any inherited parent config. MD013 (line-length) is
  // excluded — long lines are allowed, as in the qte77 CI markdownlint
  // config. MD041 (first-line-heading) and MD060 (table style) stay on.
  "config": {
    "default": true,
    "MD013": false
  },
  "ignores": ["**/.venv/**", "**/node_modules/**"]
}
